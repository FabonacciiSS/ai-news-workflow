# Copy to .env before starting n8n (AI News Workflow v2.1.0)

# n8n security
N8N_PASSWORD=your_secure_password
N8N_ENCRYPTION_KEY=replace_with_random_hex

# Feishu app credentials
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=your_feishu_secret
FEISHU_TABLE_APP_TOKEN=your_bitable_app_token
FEISHU_TABLE_ID=tblxxxx
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
FEISHU_DOC_ID=doccnxxxxxxxx

# AI model credential
DEEPSEEK_API_CREDENTIAL_ID=your_deepseek_credential

# Optional publishers
WEIBO_APP_KEY=微博AppKey
WEIBO_APP_SECRET=微博AppSecret
WEIBO_ACCESS_TOKEN=微博AccessToken
WEIBO_UID=微博UID

# WeChat draft API
WECHAT_APPID=wx1234567890
WECHAT_APPSECRET=your_wechat_secret
WECHAT_WHITELISTED_IPS=39.144.xxx.xxx,108.181.xxx.xxx

# Dedup table (若与采集表不同)
FEISHU_TABLE_APP_TOKEN_DEDUP=token_for_dedup_table
FEISHU_TABLE_ID_DEDUP=tblxxxx_dedup
