# AI News Workflow Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# 飞书 (Feishu) 配置
# ===========================================
# 飞书应用ID
FEISHU_APP_ID=your_feishu_app_id_here

# 飞书应用密钥
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 飞书多维表格应用Token
FEISHU_TABLE_APP_TOKEN=your_feishu_table_app_token_here

# 飞书多维表格ID
FEISHU_TABLE_ID=your_feishu_table_id_here

# 飞书群聊机器人Webhook URL (用于发送摘要)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id_here

# ===========================================
# DeepSeek API 配置
# ===========================================
# DeepSeek API 凭证ID (在n8n中配置的凭证ID)
DEEPSEEK_API_CREDENTIAL_ID=your_deepseek_credential_id_here

# ===========================================
# 微博 (Weibo) 配置 (可选)
# ===========================================
# 微博应用Key
WEIBO_APP_KEY=your_weibo_app_key_here

# 微博应用密钥
WEIBO_APP_SECRET=your_weibo_app_secret_here

# 微博访问令牌
WEIBO_ACCESS_TOKEN=your_weibo_access_token_here

# 微博用户ID
WEIBO_UID=your_weibo_uid_here

# 微博授权码 (用于获取访问令牌)
WEIBO_AUTH_CODE=your_weibo_auth_code_here

# ===========================================
# 其他配置
# ===========================================
# 时区设置
TIMEZONE=Asia/Shanghai

# RSS源配置 (可选，用于自定义RSS源)
# RSS_SOURCES=source1,source2,source3
